+func TestExtractAllowsRootDirectoryEntry(t *testing.T) {
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	if err := tw.WriteHeader(&tar.Header{
+		Name:     ".",
+		Mode:     0o755,
+		Typeflag: tar.TypeDir,
+	}); err != nil {
+		t.Fatalf("WriteHeader root directory: %v", err)
+	}
+	const body = "hello"
+	if err := tw.WriteHeader(&tar.Header{
+		Name:     "app/hello.txt",
+		Mode:     0o644,
+		Size:     int64(len(body)),
+		Typeflag: tar.TypeReg,
+	}); err != nil {
+		t.Fatalf("WriteHeader file: %v", err)
+	}
+	if _, err := tw.Write([]byte(body)); err != nil {
+		t.Fatalf("Write file: %v", err)
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatalf("tar Close: %v", err)
+	}
+
+	img := imageFromTarBytes(t, buf.Bytes())
+	tr := tar.NewReader(mutate.Extract(img))
+	hdr, err := tr.Next()
+	if err != nil {
+		t.Fatalf("reading extracted tar: %v", err)
+	}
+	if hdr.Name != "app/hello.txt" {
+		t.Fatalf("first extracted entry = %q, want app/hello.txt", hdr.Name)
+	}
+	got, err := io.ReadAll(tr)
+	if err != nil {
+		t.Fatalf("reading extracted file: %v", err)
+	}
+	if string(got) != body {
+		t.Fatalf("extracted file = %q, want %q", got, body)
+	}
+	if _, err := tr.Next(); !errors.Is(err, io.EOF) {
+		t.Fatalf("reading final tar entry: %v", err)
+	}
+}
